SPRING_PROFILES_ACTIVE=dev
PORT=8080

# ===== BASE DE DONNÉES (prod) =====
DB_URL=jdbc:postgresql://localhost:5432/delivery_db
DB_USERNAME=delivery_user
DB_PASSWORD=delivery_password

# ===== REDIS =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ===== JWT =====
JWT_SECRET=change-this-secret-key-in-production-min-32-chars

# ===== MICROSERVICES =====
NOTIFICATION_SERVICE_URL=http://localhost:8081
AUDIT_SERVICE_URL=http://localhost:8082

# ===== POSTGRESQL (docker-compose) =====
POSTGRES_DB=delivery_db
POSTGRES_USER=delivery_user
POSTGRES_PASSWORD=delivery_password

# ===== PGADMIN (optionnel) =====
PGADMIN_EMAIL=admin@delivery.ga
PGADMIN_PASSWORD=admin123